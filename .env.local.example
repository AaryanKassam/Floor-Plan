# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. That file is gitignored.
# These are read only in server-side route handlers (src/app/api/**) and are
# never sent to the browser. Never rename one to start with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- Vision provider: you need ONE of these two. -------------------------
# Gemini has a free tier and is the default when both are present, which is
# what makes this repo cheap for anyone who clones it.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Overrides the default model (gemini-3.6-flash). Use this if your
# account has a different one available, e.g. gemini-3.7-flash.
GEMINI_MODEL=

# Alternative provider. Used only when GEMINI_API_KEY is absent.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Force a provider when both keys are set: "gemini" or "anthropic".
VISION_PROVIDER=

# --- Google Sheets mirror (optional) -------------------------------------
# Apps Script Web App URL. See google-apps-script.gs for the 3-minute setup.
SHEETS_WEBHOOK_URL=

# Shared secret; must match SECRET in the Apps Script source.
SHEETS_TOKEN=
